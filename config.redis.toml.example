# Redis Configuration for Golbat
# This configuration enables Redis-based caching and async write queuing

[redis]
# Enable Redis integration
enabled = true

# Redis server addresses
# If running Redis via docker-compose.redis.yml, use localhost:6379
# If running on separate host, use hostname:6379
addresses = ["localhost:6379"]

# Redis password (leave empty if no auth)
password = ""

# Redis database number
db = 0

# Connection pool size (adjust based on workload)
# Recommended: 50-100 for high-load scenarios
pool_size = 100

# Cache TTL in minutes (how long data stays in Redis without updates)
# Recommended: 120 minutes (2 hours) - balanced approach
# - Active data refreshes constantly anyway (never expires)
# - Inactive data expires after 2 hours (frees memory efficiently)
# - Survives most scanner pauses and short maintenance
cache_ttl_minutes = 120

# Stream trim target - workers periodically trim streams to this size
# This keeps streams lean and Redis fast
# Recommended: 2-3x your (writer_workers × writer_batch_size)
# Example: 75 workers × 3000 batch = 225k capacity → set to 100k-200k
# Lower = faster trimming, less memory
# Higher = more buffer for bursts
stream_trim_target = 100000

# Batch size for DB writer workers
# Each worker processes this many operations per batch
# Recommended: 300-1000 depending on DB performance
writer_batch_size = 500

# Number of DB writer workers (within single golbat-writer process)
# Each worker is a goroutine consuming from Redis Streams
# Recommended: 4-8 for most workloads, 8-16 for very high load
writer_workers = 4

# =========================================================================
# PERSISTENT CACHE: Single option for all startup loading + Redis caching
# =========================================================================
# Handles ALL static objects: Pokestops, Gyms, Stations, Routes, Spawnpoints (hot, last 7 days)
# 
# What it does:
# - On startup: Loads all data from Redis (1-2 min) OR from DB if Redis empty (20-30 min)
# - During runtime: Continuously updates Redis with TTL
# - On restart: Fast reload from Redis, preserving quest/raid/battle data
# 
# Benefits:
# - Fast restart: 1-2 min from Redis (vs 20-30 min from DB)
# - Data preservation: Quest, raid, battle, route data intact across restarts
# - DB fallback: Automatic fallback to DB if Redis unavailable
# - Targeted updates: After restart, old state available for comparison
# 
# Memory usage in Redis:
# - Pokestops: ~750 MB (1.5M objects)
# - Gyms: ~500 MB (1.0M objects)
# - Stations: ~40 MB (100K objects)
# - Routes: ~25 MB (50K objects)
# - Spawnpoints: ~900 MB (4.5M hot spawnpoints, last 7 days)
# - Total: ~2.2 GB (acceptable for 100GB Redis)
#
# THIS IS THE SINGLE OPTION for all startup loading and persistent caching
persistent_cache_enabled = true

# How long to keep data in Redis cache (in hours)
# Recommended: 24 hours (survives daily restarts, preserves all data)
persistent_cache_ttl_hours = 24

# ---------------------------------------------------------
# Maintenance Window Handling
# ---------------------------------------------------------
# If you pause scanners for maintenance (e.g., 2 hours):
# 1. Keep Golbat running → L1 cache preserved
# 2. Set persistent_cache_ttl_hours = 24+ → Redis survives pause
# 3. On Golbat restart → persistent cache reloads from Redis (1-2 min)
# Result: Fast reload from Redis instead of DB ✅

# Example full configuration:
# Copy the relevant sections to your config.toml

