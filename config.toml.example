port = 9001             # Listening port for golbat
#grpc_port = 50001       # Listening port for grpc
raw_bearer = ""         # Raw bearer (password) required
api_secret = "golbat"   # Golbat secret required on api calls (blank for none)

pokemon_memory_only = false  # Use in-memory storage for pokemon only

[koji]
url = "http://{koji_url}/api/v1/geofence/feature-collection/{golbat_project}"
bearer_token = "secret"

[cleanup]
pokemon = true                  # Keep pokemon table is kept nice and short
incidents = true                # Remove incidents after expiry
quests = true                   # Remove quests after expiry
tappables = true                # Remove tappables after expiry
stats = true                    # Enable/Disable stats history
stats_days = 7                  # Remove entries from "pokemon_stats", "pokemon_shiny_stats", "pokemon_iv_stats", "pokemon_hundo_stats", "pokemon_nundo_stats", "invasion_stats", "quest_stats", "raid_stats" after x days
device_hours = 24               # Remove devices from in memory after not seen for x hours
forts_stale_threshold = 3600    # Seconds before a fort is considered stale (default: 1 hour)

[logging]
debug = false
save_logs = true
max_size = 50           # Size in MB
max_backups = 10        # Amount of files to keep
max_age = 30            # Day(s) to keep files
compress = true         # Compress to gz archive

[database]
user = ""
password = ""
address = "127.0.0.1:3306"
db = ""

[redis]
enabled = false                      # Enable Redis for async DB writes and persistent cache
addresses = ["127.0.0.1:6379"]       # Redis server addresses (can specify multiple for cluster)
password = ""                        # Redis password (leave empty if no auth)
db = 0                               # Redis database number (0-15, use different DBs to separate prod/dev)
pool_size = 2000                     # Redis connection pool size (tune based on load)
writer_batch_size = 3000             # How many records each writer processes per batch
writer_workers = 75                  # Number of writer workers (tune based on CPU/load)

# Stream management - workers periodically trim streams to this target size
# Prevents unbounded growth while keeping trimming fast (<20ms)
stream_trim_target = 100000          # Target stream length (per stream: critical, high, normal)

# Persistent cache: Handles ALL static objects (pokestops, gyms, stations, routes, hot spawnpoints)
# - On startup: Loads from Redis (1-2 min) OR from DB if Redis empty (20-30 min)  
# - During runtime: Continuously updates Redis with 24h TTL
# - Preserves quest data and prevents full DB write storms on restart
persistent_cache_enabled = true      # SINGLE option to enable persistent cache + startup loading
persistent_cache_ttl_hours = 24      # How long to keep data in Redis (default: 24 hours)

# Persistent cache optimization: Only load RECENT data (reduces startup time & memory)
[redis.persistent_cache]
pokestop_max_age_days = 30           # Only load pokestops updated in last 30 days
gym_max_age_days = 30                # Only load gyms updated in last 30 days
station_max_age_days = 90            # Only load stations updated in last 90 days
route_max_age_days = 90              # Only load routes updated in last 90 days
spawnpoint_max_age_days = 7          # Only load spawnpoints seen in last 7 days (hot spawnpoints)

# Automatic trimming: Remove stale data from Redis to save memory
trim_enabled = true                  # Enable automatic trimming (recommended)
trim_interval_hours = 24             # Trim every 24 hours

[pvp]
enabled = true
include_hundos_under_cap = false

# you can enable prometheus by uncommenting this section
#[prometheus]
#enabled = true

# You can specify more than one webhook destination by including the [[webhooks]] section
# multiple times.  The hook types can optionally be filtered by using the types array

[[webhooks]]
url = "http://localhost:4201"
# types if specified can be...
# types = ["pokemon", "pokemon_iv", "pokemon_no_iv", "gym", "invasion", "quest", "pokestop", "raid", "weather", "fort_update", "max_battle"]
# "pokemon" includes both with ivs and without. "pokemon_iv" will only be encountered pokemon. "pokemon_no_iv" may be nearby pokemon that have not been encountered (yet).

#[[webhooks]]
#url = "http://localhost:4202"
#types = ["raid"]
#headers = ["X-Poracle-Secret:abc", "Other-Header:def"]

#[[webhooks]]
#url = "http://localhost:4202"
#types = ["raid"]
#areas = ["London/*", "*/Harrow", "Harrow"]

[tuning]
max_pokemon_distance = 100  # Maximum distance in kilometers for searching pokemon
max_pokemon_results = 3000  # Maximum number of pokemon to return
extended_timeout = false
profile_routes = false
startup_delay_sec = 0  # Delay (seconds) after data loading before GRPC accepts traffic
                       # Set to 10-30 if using DB fallback loading to let system stabilize
                       # Set to 0 if loading from Redis (no delay needed)

# Force update intervals (seconds) - objects are re-saved after this interval even if unchanged
# This confirms objects still exist and prevents stale data
# Adjust based on how frequently each type changes:
force_update_pokestop = 900    # 15 minutes (quests/lures change frequently)
force_update_gym = 900         # 15 minutes (raids change frequently)
force_update_station = 3600    # 1 hour (battles don't change often)
force_update_route = 86400     # 24 hours (routes are very static)
force_update_spawnpoint = 86400  # 24 hours (spawn times are very static)

[weather]
proactive_iv_switching = true       # Enable proactive IV switching upon weather changes (default: true)
proactive_iv_switching_to_db = false # Write proactive IV changes to database (default: false)
